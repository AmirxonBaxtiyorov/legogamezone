{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20"
  },
  "steps": {
    "install": {
      "commands": [
        "npm install --workspace=backend --include-workspace-root --no-audit --no-fund"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "cd backend && npx prisma generate",
        "npm run build --workspace=backend"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm run start --workspace=backend"
  }
}
