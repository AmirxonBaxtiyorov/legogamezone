# ============================================================
# Game Zone Qarz — Railway / production environment variables
# ============================================================
# BUNDA SECRET BO'LMASIN — bu fayl namuna.
# Real qiymatlarni Railway dashboard'da Variables ichida sozlang.
# ============================================================

# ----------------------------------------------------------
# BACKEND service (api.legogamezone.uz)
# ----------------------------------------------------------
NODE_ENV=production
TZ=Asia/Tashkent
LOG_LEVEL=info

# Railway PostgreSQL plugin avtomatik DATABASE_URL beradi.
# Backend service'dagi Variables'ga reference bilan ulang:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Railway PORT ni avtomatik beradi — biz uni hurmat qilamiz.
# (Backend env.ts process.env.PORT'ni o'qiydi.)
# PORT=  ← Railway o'rnatadi, qo'lda bermang.

# ----- JWT (MUHIM: kuchli secret kerak) -----
# Mahalliyda yarating: openssl rand -base64 64
# Yoki PowerShell: -join ((1..64) | % { [char]((33..126) | Get-Random) })
JWT_SECRET=<KAMIDA-64-BELGILI-TASODIFIY-STRING>
JWT_EXPIRES_IN=1d
JWT_EXPIRES_IN_REMEMBER=30d
BCRYPT_SALT_ROUNDS=12

# ----- CORS (frontend domeni) -----
# Vergul bilan ajratilgan ro'yxat
CORS_ORIGIN=https://legogamezone.uz,https://www.legogamezone.uz,https://api.legogamezone.uz

# ----- Rate limiting -----
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=100

# ----- Backup (ixtiyoriy — Railway'da fayl tizimi efemer) -----
BACKUP_DIR=/tmp/backups
BACKUP_RETENTION_DAYS=7


# ============================================================
# FRONTEND service (legogamezone.uz)
# ============================================================
# Frontend Vite — build vaqtida o'qiladi. Railway service uchun:
#
# Build env (build paytida kerak):
VITE_API_URL=https://api.legogamezone.uz
#
# Boshqa env'lar frontend'da kerak emas — u faqat statik HTML/CSS/JS.
