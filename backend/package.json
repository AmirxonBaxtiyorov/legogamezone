{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Game Zone Qarz backend API",
  "main": "dist/preview-server.js",
  "scripts": {
    "dev": "tsx watch src/preview-server.ts",
    "dev:setup": "prisma generate --schema=prisma/schema.dev.prisma && prisma db push --schema=prisma/schema.dev.prisma --accept-data-loss",
    "preview": "tsx src/preview-server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "postinstall": "prisma generate || echo 'prisma generate skipped'",
    "start": "prisma db push --accept-data-loss --skip-generate && node dist/preview-server.js",
    "start:no-migrate": "node dist/preview-server.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:push:dev": "prisma db push --schema=prisma/schema.dev.prisma --accept-data-loss",
    "db:generate:dev": "prisma generate --schema=prisma/schema.dev.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "tsx prisma/seed-production.ts",
    "db:studio": "prisma studio",
    "db:studio:dev": "prisma studio --schema=prisma/schema.dev.prisma",
    "db:reset": "prisma migrate reset --force",
    "db:reset:dev": "prisma migrate reset --schema=prisma/schema.dev.prisma --force --skip-seed",
    "db:generate": "prisma generate",
    "lint": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed-production.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  }
}
