# ============================================================
# Game Zone Qarz — backend .env namunasi
# ============================================================
# .env.example fayli versiya nazoratiga kiritiladi.
# .env (real qiymatlar bilan) — kiritilmasin (.gitignore).
# ============================================================

# --- Muhit ---
NODE_ENV=development
PORT=4000
TZ=Asia/Tashkent
LOG_LEVEL=debug

# --- Ma'lumotlar bazasi ---
# LOCAL DEV (SQLite — schema.dev.prisma):
DATABASE_URL="file:./dev.db"
# Production (Railway/Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/gamezone?schema=public"

# --- JWT ---
# Production'da kamida 64 belgili tasodifiy string ishlating!
# Yaratish (PowerShell): -join ((1..64) | % { [char]((33..126) | Get-Random) })
# Yaratish (bash):       openssl rand -base64 64
JWT_SECRET=local-dev-secret-at-least-64-chars-long-aaaa-bbbb-cccc-dddd-eeee-ffff-gggg
JWT_EXPIRES_IN=1d
JWT_EXPIRES_IN_REMEMBER=30d

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=10

# --- CORS (vergul bilan ajratilgan ro'yxat) ---
CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# --- Telegram bot (ixtiyoriy — local'da bo'sh qoldirish mumkin) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- Backup ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=200
